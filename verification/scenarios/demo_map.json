{
  "id": "demo_map",
  "map": "content/maps/de_ash.layout.json",
  "mode": "match",
  "description": "de_ash 5v5 地图/导航双检查（A 轨）：MapDef 由派生盒子注入（全尺寸 4096），10 人 5v5 分队、C4/拆弹器；两层导航（L0 地面 / L2 +128 经楼梯）连通；A/B 双点与猫道/天桥可达且可实走；出生点互不对穿；屋顶不可达；200+ tick 自动对局可推进。",
  "script": [
    {
      "action": "check",
      "name": "match_start",
      "asserts": [
        {
          "player": 0,
          "field": "player_count",
          "equals": 10
        },
        {
          "player": 0,
          "field": "round_number",
          "equals": 1
        },
        {
          "player": 0,
          "field": "round_phase",
          "equals": 0
        },
        {
          "player": 0,
          "field": "alive_count_t",
          "equals": 5
        },
        {
          "player": 0,
          "field": "alive_count_ct",
          "equals": 5
        },
        {
          "player": 0,
          "field": "has_bomb",
          "equals": 1
        },
        {
          "player": 0,
          "field": "z",
          "equals": 0
        },
        {
          "player": 0,
          "field": "wall_count",
          "min": 90
        }
